{
  "name": "kidsmedia-admin",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
    "build": "pnpm gen:api && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "pnpm gen:api && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "i18next": "^27.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.3.0",
    "vitest": "^5.1.0"
  }
}
