# Copied to /opt/kidsmedia/.env by install.sh. Values here are read by
# docker compose (KM_*, KIDSMEDIA_IMAGE, KIDSMEDIA_TAG) and by the app (everything else).

# --- docker compose ---------------------------------------------------------
# Image: the public one, or an image built on it (deploy/README.md → "Family image").
KIDSMEDIA_IMAGE=ghcr.io/docdru/kidsmedia
# Image tag: latest, a version (e.g. 0.1.0) or a commit sha.
KIDSMEDIA_TAG=latest
# Port on 127.0.0.1 that nginx proxies to.
KM_PORT=8080
# Owner of /opt/kidsmedia/data. nginx must be able to read data/media and
# data/thumbs (X-Accel-Redirect), e.g. by group membership of www-data.
KM_UID=10001
KM_GID=10001

# --- app (SPEC §4.1) ----------------------------------------------------------
# Day boundaries, weekdays and lockout windows are evaluated in this zone.
TZ=Europe/Berlin
PUBLIC_URL=https://media.example.com
# Fallback admin language for browsers that are not en, de or el.
DEFAULT_LOCALE=en
# true behind nginx (it serves the media bytes); false for local dev without nginx.
ACCEL_REDIRECT=true
MAX_UPLOAD_MB=4096

# Read aloud (SPEC §14.3): a Piper voice per language, by name. Empty = the
# default: a voice in data/voices/ listed in voices.json (e.g. el_GR-joy-medium),
# else the voice bundled in the image. See deploy/README.md.
VOICE_DE=
VOICE_EN=
VOICE_EL=
# Render speech files in the background (Piper on the CPU).
SPEECH_WORKER=true

# First-run admin account (stored hashed; used from M1 on).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
